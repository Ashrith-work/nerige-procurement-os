# =============================================================================
# Nerige — vendor portal
# Copy to .env.local and fill in. .env.local is gitignored.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DANGER: bypasses Row Level Security completely.
#
# LOCAL ONLY. Do NOT set this in Vercel or any other deployment. Nothing the
# application renders reads it — only scripts/setup-supabase.ts and
# scripts/provision-user.ts, both of which run from a laptop. A key that
# bypasses every policy has no business sitting in an environment that serves
# public requests.
#
# Never prefixed NEXT_PUBLIC_ (that would ship it to the browser), and never in
# a code path that handles vendor input. If you reach for it to "make a query
# work", the fix is a missing RLS policy.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application -------------------------------------------------------------
# Used to build magic-link and OAuth redirects. Must be present in the Supabase
# Auth redirect allow-list, or a sign-in link lands on an error page.
#
# Optional on Vercel: appUrl() falls back to the deployment's own hostname, so
# preview deployments redirect to themselves rather than to production. Set it
# explicitly on production only.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Seed loader -------------------------------------------------------------
# Direct Postgres connection used by `npm run seed` to load the CSVs in v2/.
# This connection is the owner and therefore bypasses RLS, which is why the
# loader is a script and never an application code path.
#
# Supabase: Project Settings → Database → Connection string (session mode).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
