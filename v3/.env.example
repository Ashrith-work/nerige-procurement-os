# =============================================================================
# Nerige — vendor portal
# Copy to .env.local and fill in. .env.local is gitignored.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Project Settings -> API. On newer projects these are the `publishable` and
# `secret` keys; on older ones the `anon` and `service_role` JWTs. Either
# format works — the variable names are unchanged.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DANGER: bypasses Row Level Security completely.
#
# LOCAL ONLY. Do NOT set this in Vercel or any other deployment. Nothing the
# application renders reads it — only scripts/setup-supabase.ts and
# scripts/provision-user.ts, both of which run from a laptop. A key that
# bypasses every policy has no business sitting in an environment that serves
# public requests.
#
# Never prefixed NEXT_PUBLIC_ (that would ship it to the browser), and never in
# a code path that handles vendor input. If you reach for it to "make a query
# work", the fix is a missing RLS policy.
SUPABASE_SERVICE_ROLE_KEY=

# --- Seed loader -------------------------------------------------------------
# Direct Postgres connection used by `npm run seed` and `npm run setup` to load
# the CSVs in v2/. This connection is the owner and therefore bypasses RLS,
# which is why the loader is a script and never an application code path.
#
# Supabase: Project Settings -> Database -> Connection string (session mode,
# port 5432 — not the 6543 pooler, which cannot run the migrations).
#
# Percent-encode any reserved character in the password: `@` becomes %40, or
# the URL parser reads it as the host separator.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# =============================================================================
# That is everything.
#
# Sign-in is a user ID and a password, both issued by `npm run provision`, so
# there is no auth provider to configure, no SMS gateway, no OAuth client, no
# redirect allow-list and no NEXT_PUBLIC_APP_URL. Nothing in the app builds an
# absolute URL, so nothing has to be told where it is deployed.
# =============================================================================
