# =============================================================================
# Nerige — vendor portal
# Copy to .env.local and fill in. .env.local is gitignored.
#
# Only the Supabase block is required. Every integration below it degrades to a
# button that says it is not connected, and nothing else in the portal is
# affected — the whole application runs against the seed CSVs until Shopify is
# wired up.
# =============================================================================

# --- Supabase — required -----------------------------------------------------
# Project Settings -> API. On newer projects these are the `publishable` and
# `secret` keys; on older ones the `anon` and `service_role` JWTs. Either
# format works — the variable names are unchanged.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DANGER: bypasses Row Level Security completely.
#
# This is now needed in the DEPLOYED environment, which is a change from the
# earlier build and is worth understanding rather than copying.
#
# The admin panel creates vendor logins, and creating an `auth.users` row is not
# expressible under RLS — no policy of ours reaches Supabase's own auth schema.
# Three code paths hold this key and no others:
#
#   * creating and re-issuing a vendor login (admin panel, behind requireProcurement)
#   * the scheduled sync route, which has no session to run as
#   * the WhatsApp delivery webhook, which has no session either
#
# Everything else — every screen, every query, every other action — runs as the
# signed-in user under RLS. If you reach for this key to "make a query work",
# the fix is a missing policy.
#
# Never prefixed NEXT_PUBLIC_ (that would ship it to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# --- Seed loader — local only ------------------------------------------------
# Direct Postgres connection used by `npm run seed` and `npm run setup` to load
# the CSVs in v2/. This connection is the owner and therefore bypasses RLS,
# which is why the loader is a script and never an application code path.
#
# Supabase: Project Settings -> Database -> Connection string (session mode,
# port 5432 — not the 6543 pooler, which cannot run the migrations).
#
# Percent-encode any reserved character in the password: `@` becomes %40, or
# the URL parser reads it as the host separator.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# --- Shopify — the live catalogue and sales history --------------------------
# See docs/shopify-setup.md. Custom app, Admin API, scopes read_products,
# read_inventory and read_orders — plus read_all_orders, or the sales backfill
# silently stops at 60 days and every older design reads as "never sold".
#
# Until these are set, `products` holds whatever the CSV loader put there and
# every sales figure is zero. Nothing breaks.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Proves the scheduled sync is the scheduler and not a stranger. Generate with
# `openssl rand -hex 32`. If unset, /api/sync refuses everything — deliberate,
# because the alternative is an open URL that starts Shopify bulk operations.
CRON_SECRET=

# --- WhatsApp Cloud API — sending orders to a weaver's phone -----------------
# See docs/whatsapp-setup.md, and start docs/whatsapp-template.md FIRST: Meta
# has to approve the template before any message can be sent, and that is the
# only step with a queue in front of it.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Delivery receipts. Without these, "sent" means "handed to Meta" and never
# "arrived" — a wrong number accepts the send and fails silently minutes later.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# The language the TEMPLATE was approved in — not the weaver's language.
# Conflating the two is a common cause of error 132001 on a correct setup.
WHATSAPP_TEMPLATE_NAME=nerige_new_order
WHATSAPP_TEMPLATE_LANGUAGE=en

# --- Google Drive — where purchase orders are filed --------------------------
# See docs/google-drive-setup.md.
#
# Sharing the folder with this address is a separate step from pasting its link
# into Settings, and skipping it is the failure everyone hits: uploads return
# "File not found" for a folder whose link opens fine in your own browser.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the literal \n sequences and the surrounding quotes. A key that loses
# them fails signing with an ASN.1 error that names nothing useful.
GOOGLE_PRIVATE_KEY=

# --- Slack — where the PO link is announced ----------------------------------
# See docs/slack-setup.md. Bot token, starting xoxb-. The channel itself is
# chosen from a picker in Settings and stored in the database, so it can be
# changed without a deploy.
SLACK_BOT_TOKEN=

# =============================================================================
# Sign-in needs nothing configured. It is a user ID and a password, both issued
# from the admin panel — so there is no auth provider, no SMS gateway, no OAuth
# client, no redirect allow-list and no NEXT_PUBLIC_APP_URL. Nothing in the app
# builds an absolute URL, so nothing has to be told where it is deployed.
# =============================================================================
