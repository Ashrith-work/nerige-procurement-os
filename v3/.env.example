# =============================================================================
# Nerige — vendor portal
# Copy to .env.local and fill in. .env.local is gitignored.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DANGER: bypasses Row Level Security completely.
#
# Never prefixed NEXT_PUBLIC_ (that would ship it to the browser), and never in
# a code path that handles vendor input. Used only for provisioning logins,
# which is the one operation that genuinely cannot be performed under RLS.
#
# If you reach for it to "make a query work", the fix is a missing RLS policy.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application -------------------------------------------------------------
# Used to build magic-link and OTP deep-link redirects. Must match the Supabase
# Auth "Site URL" and be present in the redirect allow-list, or vendors land on
# an error page after tapping their SMS link.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Seed loader -------------------------------------------------------------
# Direct Postgres connection used by `npm run seed` to load the CSVs in v2/.
# This connection is the owner and therefore bypasses RLS, which is why the
# loader is a script and never an application code path.
#
# Supabase: Project Settings → Database → Connection string (session mode).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
