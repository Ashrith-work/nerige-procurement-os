{
  "name": "nerige-vendor-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run i18n:check",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "i18n:check": "tsx scripts/check-messages.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:isolation": "vitest run tests/isolation.test.ts",
    "seed": "tsx scripts/load-seed.ts",
    "seed:verify": "tsx scripts/verify-seed.ts",
    "setup": "tsx scripts/setup-supabase.ts",
    "seed:order": "tsx scripts/seed-demo-order.ts",
    "preview:order": "tsx scripts/preview-screen.tsx --screen order",
    "preview:catalogue": "tsx scripts/preview-screen.tsx --screen catalogue",
    "provision": "tsx scripts/provision-user.ts",
    "provision:vendors": "tsx scripts/provision-vendors.ts",
    "verify": "npm run i18n:check && npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "google-auth-library": "^11.0.0",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "next-intl": "^4.13.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "pg": "^8.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "@swc/core@1.15.47": true,
    "unrs-resolver@1.12.2": true,
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true
  }
}
