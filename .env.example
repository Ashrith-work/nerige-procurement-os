# =============================================================================
# Nerige Story — Procurement OS
# Copy to .env.local and fill in. .env.local is gitignored.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DANGER: bypasses Row Level Security completely.
#
# This key must NEVER appear in a code path that handles vendor input, and must
# never be prefixed NEXT_PUBLIC_ (that would ship it to the browser). It is used
# only by src/lib/supabase/admin.ts for user provisioning, which is the one
# operation that genuinely cannot be performed under RLS.
#
# If you find yourself reaching for it to "make a query work", the correct fix
# is almost always a missing RLS policy.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application -------------------------------------------------------------
# Used to build magic-link and OTP deep-link redirects. Must match the
# Supabase Auth "Site URL" and be present in the redirect allow-list, or
# vendors will land on an error page after tapping their SMS link.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- SMS (vendor phone OTP) --------------------------------------------------
# Vendors sign in by phone OTP, which requires an SMS provider configured in
# Supabase Auth → Providers → Phone. MSG91 is the usual India choice; Twilio
# works but costs more per message and needs DLT registration for Indian
# delivery. Nothing here is read by the app — Supabase sends the SMS — but the
# provider must be configured or vendor login silently fails.
# See docs/SETUP.md.

# --- n8n (outbox consumer) ---------------------------------------------------
# n8n drains the `events` table using the service role and performs side
# effects only. It never holds business state.
N8N_WEBHOOK_URL=
N8N_SHARED_SECRET=
