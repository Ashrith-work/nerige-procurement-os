# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Unanchored patterns, deliberately: the repository holds v1, v2 and v3 side by
# side, and a leading slash would only ignore the root copy of each.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# agent tooling — local settings and scratch worktrees
.claude/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — all ignored except the documented template
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# rendered previews (scripts/preview-screen.tsx)
*-preview.html
